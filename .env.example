# Backend API Configuration
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/student_attendance_db
JWT_SECRET=super_secure_college_project_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Mobile App Environment (mobile/.env)
# For Mac / iOS Simulator: http://localhost:5001/api
# For Android Emulator: http://10.0.2.2:5001/api
# For Physical Phones (LAN): http://<YOUR_LOCAL_IP>:5001/api (e.g. http://192.168.1.5:5001/api)
EXPO_PUBLIC_API_URL=http://localhost:5001/api
